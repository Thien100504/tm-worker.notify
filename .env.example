# ──────────────────────────────────────────────
# Notification Service - Environment Variables
# ──────────────────────────────────────────────

# RabbitMQ
RABBITMQ_URL=amqp://taskmanager:taskmanager_dev@localhost:5672/
NOTIFICATION_QUEUE=notification_queue
NOTIFICATION_EXCHANGE=notifications

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://taskmanager:taskmanager_dev@localhost:5432/taskmanager

# Redis
REDIS_URL=redis://localhost:6379/0
NOTIFICATION_DEDUP_TTL=300

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF_BASE=5

# SMTP / Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@taskmanager.local
SMTP_FROM_NAME=Task Manager AI
EMAIL_MAX_RETRIES=2

# HTTP API (port 8001 is already used by RedisInsight)
API_PORT=8002

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared secret for the HTTP API (must match portal-api's INTERNAL_API_TOKEN).
# Leave empty only for local development; the API then binds to 127.0.0.1.
INTERNAL_API_TOKEN=
# API_HOST=0.0.0.0   # only inside a Docker network
